{
  "name": "blabee-landing",
  "private": true,
  "type": "module",
  "scripts": {
    "build:public": "node scripts/build-public.mjs",
    "check": "node --check js/content.js && node --check js/main.js && node --check scripts/build-public.mjs && node --check scripts/sync-gsap.mjs",
    "sync:gsap": "node scripts/sync-gsap.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "gsap": "3.15.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
