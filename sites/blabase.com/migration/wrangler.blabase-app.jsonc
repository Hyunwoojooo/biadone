{
  "$schema": "../../../apps/blabase/node_modules/wrangler/config-schema.json",
  "name": "blabase-app",
  "main": "../../../apps/blabase/.open-next/worker.js",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "../../../apps/blabase/.open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "blabase-app"
    }
  ],
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "preview_urls": true
}
