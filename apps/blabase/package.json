{
  "name": "blabase",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "fetcher": "node tools/chatgpt-fetcher/server.mjs",
    "golden:validate": "vite-node tools/validate-golden-dataset.ts",
    "golden:baseline": "vite-node tools/run-golden-baseline.ts",
    "arch:deps:check:repository": "depcruise --config dependency-cruiser.config.mjs src tests tools suggestion/app suggestion/src suggestion/tests suggestion/tools suggestion/e2e suggestion/playwright.config.ts suggestion/middleware.ts suggestion/desktop/macos/scripts",
    "arch:deps:check:suggestion": "depcruise --config dependency-cruiser.suggestion.config.mjs app src tests tools e2e playwright.config.ts middleware.ts desktop/macos/scripts",
    "arch:deps:check:scripts": "node tools/architecture/dependency-artifacts.mjs check-scripts",
    "arch:deps:check": "npm run arch:deps:check:repository && npm run arch:deps:check:suggestion && npm run arch:deps:check:scripts",
    "arch:deps:graph": "node tools/architecture/dependency-artifacts.mjs graph",
    "arch:deps:report": "node tools/architecture/dependency-artifacts.mjs report",
    "arch:model:dev": "likec4 start architecture --listen 127.0.0.1",
    "arch:model:check": "likec4 validate architecture",
    "arch:model:format": "likec4 format architecture",
    "arch:model:format:check": "likec4 format architecture --check",
    "arch:model:build": "likec4 build architecture --output artifacts/architecture/likec4",
    "arch:sources:check": "node tools/architecture/check-model-links.mjs",
    "arch:trace:config:check": "node tools/architecture/check-appmap-config.mjs",
    "arch:trace:dev": "node tools/architecture/appmap-dev-guard.mjs",
    "arch:trace:test": "appmap-node npx vitest run tests/integration/chatgptShareAdapter.test.ts",
    "arch:check": "npm run arch:deps:check && npm run arch:sources:check && npm run arch:trace:config:check && npm run arch:model:format:check && npm run arch:model:check",
    "arch:build": "npm run arch:deps:graph && npm run arch:deps:report && npm run arch:model:build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "google-auth-library": "^10.9.0",
    "lucide-react": "^0.468.0",
    "next": "^15.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "appmap-node": "2.26.1",
    "dependency-cruiser": "18.2.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^15.5.20",
    "likec4": "1.59.2",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.112.0"
  }
}
