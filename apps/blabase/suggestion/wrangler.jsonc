{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blabase-suggestion",
  "account_id": "210a22672538579a7236dc379b00649c",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "blabase-suggestion"
    }
  ],
  "observability": {
    "enabled": true
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "suggestion.blabase.com",
      "custom_domain": true
    }
  ]
}
