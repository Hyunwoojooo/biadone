BLABASE_SUGGESTION_PROVIDER=gemini
BLABASE_SUGGESTION_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=

# 이미 관리 중인 비공개 env 파일을 복제하지 않고 재사용할 수 있습니다.
BLABASE_SHARED_ENV_PATH=

# ChatGPT 직접 요청이 차단될 때만 사용합니다.
CHATGPT_SHARE_FETCHER_URL=
CHATGPT_SHARE_FETCHER_SECRET=

# Google Cloud에서 만든 Web OAuth credentials.json의 로컬 경로입니다.
# 비워두면 .local/connectors/google-calendar/credentials.json을 사용합니다.
GOOGLE_CALENDAR_CREDENTIALS_PATH=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3102/api/connectors/google-calendar/callback

# Notion Developer portal에서 만든 Public connection의 OAuth 설정입니다.
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=http://localhost:3102/api/connectors/notion/callback

# GitHub Developer settings에서 만든 GitHub App 설정입니다.
# 비밀값은 Git에 커밋하지 말고 로컬 비공개 env에만 보관하세요.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_REDIRECT_URI=http://localhost:3102/api/connectors/github/callback

# 보통 설정할 필요가 없습니다. Codex 자동 탐색이 실패할 때만 실행 파일의
# 절대 경로를 지정하세요. OAuth나 별도 API key는 필요하지 않습니다.
BLABASE_CODEX_BINARY_PATH=
