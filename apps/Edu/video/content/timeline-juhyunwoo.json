      "durationSeconds": 11.937959,
      "durationInFrames": 387
    },
    {
      "id": "choice",
      "audio": "audio/juhyunwoo-v5/04-choice.mp3",
      "alignment": "audio/juhyunwoo-v5/04-choice.alignment.json",
