{
  "name": "biadone-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --import tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "mcp": "node --import tsx server/mcp.ts",
    "qa": "node --import tsx scripts/qa.ts",
    "qa:scenes": "node --import tsx scripts/qa-storyboard.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "^5.2.0",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "@remotion/bundler": "4.0.538",
    "@remotion/player": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "express": "^5.1.0",
    "lucide-react": "^0.577.0",
    "multer": "^2.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "4.0.538",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "playwright": "^1.58.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.4.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "zod": "$zod"
  }
}
