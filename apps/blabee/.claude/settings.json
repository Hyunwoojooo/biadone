{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git branch)",
      "Bash(git branch --list:*)",
      "Bash(git worktree list)",
      "Bash(git ls-files:*)",
      "Bash(git check-ignore:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(shasum:*)",
      "Bash(node --check:*)",
      "Bash(node --test:*)",
      "Bash(npm test)",
      "Bash(npm run test:*)",
      "Bash(npm --prefix bridges/claude run check)",
      "Bash(npm --prefix bridges/claude test)",
      "Bash(npm --prefix bridges/claude run test:*)",
      "Bash(npm --prefix account-web test)",
      "Bash(npm --prefix dev/claude-standalone test)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git restore:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git stash:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git worktree remove:*)",
      "Bash(git worktree prune:*)",
      "Bash(git tag:*)",
      "Bash(npm run build:*)",
      "Bash(npm run notarize:*)",
      "Bash(npm run prepare:*)",
      "Bash(npm run qualify:*)",
      "Bash(supabase:*)",
      "Bash(psql:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(supabase db push:*)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Edit(./**/.env)",
      "Edit(./**/.env.local)",
      "Edit(./**/.env.*.local)",
      "Edit(./**/.env.production)"
    ]
  }
}
