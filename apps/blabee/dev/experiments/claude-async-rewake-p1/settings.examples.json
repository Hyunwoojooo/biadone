  "async-exit0": {
    "syncClaudeAiPlugins": false,
    "disableClaudeAiConnectors": true,
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "/usr/bin/env",
              "args": [
                "-u",
                "NODE_OPTIONS",
                "-u",
                "NODE_PATH",
                "/ABSOLUTE/PATH/TO/node",
                "/ABSOLUTE/P1/hook.mjs",
                "--run",
                "/ABSOLUTE/PRIVATE-RUN",
                "--event",
                "SessionStart"
              ],
              "timeout": 5
            }
          ]
        }
      ],
