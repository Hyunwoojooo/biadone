{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.blabee.local/contracts/v1/action.schema.json",
  "title": "Blabee v1 action",
  "description": "The complete executable meaning sealed by the coordinator for a recommended or alternative action.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "objective",
    "constraints",
    "done_when"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "constraints": {
      "$ref": "https://schemas.blabee.local/contracts/v1/common.schema.json#/$defs/string_list"
    },
    "done_when": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "https://schemas.blabee.local/contracts/v1/common.schema.json#/$defs/non_empty_string"
      }
    }
  }
}
