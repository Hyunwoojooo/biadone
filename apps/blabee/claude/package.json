{
  "name": "blabee-claude",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:shared-engine": "node scripts/test-shared-engine.mjs",
    "test:product-ingress": "node scripts/test-product-ingress.mjs",
    "test:product-registration": "node scripts/test-product-registration.mjs",
    "test:product-lifetime": "node scripts/test-product-registration.mjs && node scripts/test-shared-engine.mjs",
    "test:product-lifecycle": "node scripts/test-product-registration.mjs && node scripts/test-shared-engine.mjs --lifecycle && node --test tests/session-v2-lifecycle.test.mjs tests/session-v2-channel-poller.test.mjs",
    "test:native-session": "node scripts/test-native-session.mjs",
    "test:common-pet": "node scripts/test-common-pet.mjs",
    "claude:shared": "node scripts/claude-shared.mjs",
    "claude:live": "node scripts/claude-shared.mjs --coordinator-bin build/shared-pet-live/scratch/out/Products/Debug/blabee-coordinator --cwd build/shared-pet-live/project --pet",
    "check": "node scripts/check.mjs",
    "doctor": "node scripts/blabee-claude.mjs doctor",
    "claude": "node scripts/blabee-claude.mjs launch",
    "app": "node scripts/blabee-claude.mjs app"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0"
  }
}
