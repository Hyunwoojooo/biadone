# Optional external/production fetcher. Set both values together.
# Leave both blank for local development; `npm run dev` starts a loopback bridge.
CHATGPT_SHARE_FETCHER_URL=
CHATGPT_SHARE_FETCHER_SECRET=

# Server-only Gemini state-note provider. Never expose the key to browser code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=

# New imports use the current-state note by default. Set to summary-v2 only
# as a temporary rollback while keeping existing v3 notes readable.
GPTMEMORY_GENERATION_MODE=state-v3
GPTMEMORY_STATE_MODEL=

# Optional: reuse an existing private env file without copying its secrets.
GPTMEMORY_SHARED_ENV_PATH=
