# Optional external/production fetcher. Set both values together.
# Leave both blank for local development; `npm run dev` starts a loopback bridge.
CHATGPT_SHARE_FETCHER_URL=
CHATGPT_SHARE_FETCHER_SECRET=

# Server-only Gemini provider. Never expose the key to browser code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=

# New imports use the topic-centered content note by default. Temporary
# rollbacks may use state-v3 or summary-v2; existing v1-v3 notes stay readable.
GPTMEMORY_GENERATION_MODE=content-v4
GPTMEMORY_CONTENT_MODEL=
GPTMEMORY_STATE_MODEL=
GPTMEMORY_SUMMARY_MODEL=

# Optional: reuse an existing private env file without copying its secrets.
GPTMEMORY_SHARED_ENV_PATH=
