# Optional external/production fetcher. Set both values together.
# Leave both blank for local development; `npm run dev` starts a loopback bridge.
CHATGPT_SHARE_FETCHER_URL=
CHATGPT_SHARE_FETCHER_SECRET=

# Server-only Gemini summary provider. Never expose the key to browser code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=

# Optional: reuse an existing private env file without copying its secrets.
GPTMEMORY_SHARED_ENV_PATH=
